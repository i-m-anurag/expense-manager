      }
    ],
    "patterns": [
      {
        "id": "axis_upi_debit",
        "type": "upi",
        "direction": "debit",
        "regex": "(?i)INR\\s*(?<amount>[\\d,]+(?:\\.\\d+)?)\\s+debited\\s+A/c\\s+no\\.\\s*[xX*]*(?<account>\\d{3,6})\\s+(?<date>\\d{2}-\\d{2}-\\d{2}),?\\s+(?<time>\\d{2}:\\d{2}(?::\\d{2})?)(?:\\s*IST)?\\s+UPI/P2[AM]/(?<ref>\\d+)/(?<payee>[^\\n]+)",
        "date_format": "dd-MM-yy"
      },
      {
        "id": "axis_upi_credit",
        "type": "upi",
        "direction": "credit",
        "regex": "(?i)INR\\s*(?<amount>[\\d,]+(?:\\.\\d+)?)\\s+credited\\s+A/c\\s+no\\.\\s*[xX*]*(?<account>\\d{3,6})\\s+(?<date>\\d{2}-\\d{2}-\\d{2}),?\\s+(?<time>\\d{2}:\\d{2}(?::\\d{2})?)(?:\\s*IST)?\\s+UPI/P2[AM]/(?<ref>\\d+)/(?<payee>[^\\n]+)",
        "date_format": "dd-MM-yy"
      },
      {
        "id": "axis_card_spend",
        "type": "credit_card",
        "direction": "debit",
        "account_kind": "card",
        "regex": "(?i)Spent\\s+Card\\s+no\\.\\s*[xX*]*(?<account>\\d{4})\\s+INR\\s*(?<amount>[\\d,]+(?:\\.\\d+)?)\\s+(?<date>\\d{2}-\\d{2}-\\d{2}),?\\s+(?<time>\\d{2}:\\d{2}(?::\\d{2})?)\\s+(?<payee>[^\\n]+)\\s+Avl\\s+Lmt\\s+INR\\s*(?<limit>[\\d,]+(?:\\.\\d+)?)",
        "date_format": "dd-MM-yy"
      },
      {
        "id": "axis_account_debit",
        "type": "other",
        "direction": "debit",
        "regex": "(?i)INR\\s*(?<amount>[\\d,]+(?:\\.\\d+)?)\\s+debited\\s+A/c\\s+no\\.\\s*[xX*]*(?<account>\\d{3,6})\\s+(?<date>\\d{2}-\\d{2}-\\d{2}),?\\s+(?<time>\\d{2}:\\d{2}(?::\\d{2})?)(?:\\s*IST)?\\s+(?:(?:N?ACH-DR|NEFT|IMPS|ATM-WDL)/)?(?<payee>[^/\\n]+)",
        "date_format": "dd-MM-yy",
        "type_overrides": [
          {
            "when": "(?i)N?ACH-DR",
            "type": "auto_debit"
          },
          {
            "when": "(?i)ATM",
            "type": "atm"
          },
          {
            "when": "(?i)\\bNEFT/",
            "type": "neft"
          },
          {
            "when": "(?i)\\bIMPS/",
            "type": "imps"
          }
        ]
      },
      {
        "id": "axis_account_credit",
        "type": "neft",
        "direction": "credit",
        "regex": "(?i)INR\\s*(?<amount>[\\d,]+(?:\\.\\d+)?)\\s+credited\\s+A/c\\s+no\\.\\s*[xX*]*(?<account>\\d{3,6})\\s+(?<date>\\d{2}-\\d{2}-\\d{2}),?\\s+(?<time>\\d{2}:\\d{2}(?::\\d{2})?)(?:\\s*IST)?\\s+(?:(?:NEFT|IMPS|RTGS)/(?:[A-Z0-9]+/)?)?(?<payee>[^/\\n]+)",
        "date_format": "dd-MM-yy",
        "type_overrides": [
          {
            "when": "(?i)salary|\\bsal\\b",
            "type": "salary"
          },
          {
            "when": "(?i)\\bIMPS/",
            "type": "imps"
          }
