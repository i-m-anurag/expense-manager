{
  "name": "@expense-manager/parser",
  "version": "0.1.0",
  "private": true,
  "description": "Turns Indian bank SMS into structured transactions. Platform-independent; runs in the app and in Node.",
  "license": "GPL-3.0-only",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build:templates": "tsx scripts/build-templates.ts",
    "check:templates": "tsx scripts/build-templates.ts --check",
