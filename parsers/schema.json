{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Expense Manager bank parser template",
  "type": "object",
  "additionalProperties": false,
  "required": ["bank", "code", "senders", "patterns"],
  "properties": {
    "bank": {"type": "string", "minLength": 2, "description": "Display name, e.g. \"HDFC Bank\""},
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Stable id used in data, e.g. \"hdfc\""},
    "senders": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[A-Z0-9]{3,9}$"},
      "description": "Sender header codes, matched against the part after the operator prefix (VM-HDFCBK, AD-HDFCBK-S)."
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern"],
        "properties": {
          "pattern": {"type": "string"},
          "reason": {"enum": ["otp", "promo", "failed", "balance", "other"]}
        }
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "direction", "regex"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "type": {
            "enum": [
              "upi",
              "debit_card",
              "credit_card",
              "neft",
              "imps",
              "rtgs",
              "atm",
              "auto_debit",
              "salary",
              "refund",
              "transfer",
              "other"
            ]
          },
          "direction": {"enum": ["debit", "credit"]},
          "account_kind": {"enum": ["account", "card"], "default": "account"},
          "regex": {
            "type": "string",
            "description": "Named groups: amount (required), account, payee, ref, date, time, balance, limit. A leading (?i) makes it case-insensitive."
          },
          "date_format": {
            "type": "string",
            "description": "Tokens: dd, d, MM, MMM, yy, yyyy. Example: dd-MM-yy, ddMMMyy, yyyy-MM-dd"
          },
          "type_overrides": {
            "type": "array",
            "description": "Refine the type from the body, e.g. NEFT credits that say SALARY.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["when", "type"],
              "properties": {
                "when": {"type": "string"},
                "type": {"$ref": "#/properties/patterns/items/properties/type"}
              }
            }
          }
        }
      }
    }
  }
}
